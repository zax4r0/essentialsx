<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Caffeine permissions -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network Switch & Custom Animator permissions -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Wi-Fi Priority permissions -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- OTA update permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".EssentialsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EssentialsX">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EssentialsX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Caffeine Background WakeLock Service -->
        <service
            android:name=".features.caffeine.CaffeineWakeLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep screen awake during user requested caffeinate sessions" />
        </service>

        <!-- Quick Settings Tile: Caffeine -->
        <service
            android:name=".features.caffeine.CaffeineTileService"
            android:exported="true"
            android:icon="@drawable/ic_coffee"
            android:label="@string/tile_caffeine"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: Network Switch -->
        <service
            android:name=".features.network.NetworkModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_signal_cellular"
            android:label="@string/tile_network_switch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: Data SIM -->
        <service
            android:name=".features.network.DataSimTileService"
            android:exported="true"
            android:icon="@drawable/ic_signal_cellular"
            android:label="Data SIM"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Network Mode Bottom Drawer Activity (Isolated Task for Quick Settings Tile) -->
        <activity
            android:name=".features.network.NetworkModeDrawerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.EssentialsX.Translucent" />

        <!-- Quick Settings Tile: Custom Animator -->
        <service
            android:name=".features.animator.AnimatorTileService"
            android:exported="true"
            android:icon="@drawable/ic_speed"
            android:label="@string/tile_custom_animator"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Wi-Fi Priority Background Service -->
        <service
            android:name=".features.wifi.WifiPriorityService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep the phone on the highest-priority saved Wi-Fi network when auto-switch is enabled" />
        </service>

        <!-- Restart Wi-Fi Priority after reboot when it was enabled -->
        <receiver
            android:name=".features.wifi.WifiBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku Client Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- FileProvider for OTA APK Installation -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
