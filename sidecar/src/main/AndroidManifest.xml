<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="DroidMode Sidecar"
        android:hasCode="true">

        <activity
            android:name=".TrampolineActivity"
            android:exported="true"
            android:enabled="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <provider
            android:name=".SidecarProvider"
            android:authorities="dev.zax4r0.droidmode.sidecar.provider"
            android:exported="true" />

        <receiver
            android:name=".SidecarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.zax4r0.droidmode.sidecar.SET_STATE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
